# Dockerfile for Notification Service Development Environment

# ========== Stage 1: Builder ==========
FROM python:3.13-slim AS builder

ENV PYTHONUNBUFFERED=1 \
    POETRY_VERSION=1.8.2 \
    POETRY_VIRTUALENVS_CREATE=false \
    POETRY_NO_INTERACTION=1

WORKDIR /application

# Install system packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Poetry
RUN curl -sSL https://install.python-poetry.org | python3 -
ENV PATH="/root/.local/bin:$PATH"

# Copy project directories
COPY auth-service/ ./auth-service
COPY server-shared/ ./server-shared

# Set working directory to main app
WORKDIR /application/auth-service

# Install all dependencies
RUN poetry install --with dev

# ========== Stage 2: Dev Runtime ==========
FROM python:3.13-slim AS dev

ENV PYTHONUNBUFFERED=1 \
    POETRY_VIRTUALENVS_CREATE=false

WORKDIR /application

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/* /root/.cache

# Copy installed packages
COPY --from=builder /usr/local/lib/python3.13 /usr/local/lib/python3.13
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
COPY auth-service/ ./auth-service
COPY server-shared/ ./server-shared

# Set working directory to app
WORKDIR /application/auth-service

EXPOSE 4002

CMD ["uvicorn", "server:app","--proxy-headers", "--host", "0.0.0.0", "--port", "4002", "--reload"]
