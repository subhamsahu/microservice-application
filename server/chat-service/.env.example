# Environment variables for Chat Service
# Copy this file to .env and fill in the actual values

# Application settings
DEVELOPMENT=true

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
GATEWAY_JWT_TOKEN=your_gateway_jwt_token_here
SECRET_KEY_ONE=super_secret_key_1
SECRET_KEY_TWO=super_secret_key_2
SERVER_IP=0.0.0.0
SERVER_PORT=4004

# URLs
CLIENT_URL=http://localhost:3000
API_GATEWAY_URL=http://localhost:4000

# Database Configuration (MongoDB)
DATABASE_URL=mongodb://localhost:27017
DATABASE=msa_chat

# Cloudinary Configuration
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_ENDPOINT=amqp://labadmin:root123@localhost:5672

# Elasticsearch Configuration
ENABLE_ES=1
ELASTIC_SEARCH_URL=http://localhost:9200

# APM Configuration (Optional)
ENABLE_APM=0
ELASTIC_APM_SERVER_URL=
ELASTIC_APM_SECRET_TOKEN=